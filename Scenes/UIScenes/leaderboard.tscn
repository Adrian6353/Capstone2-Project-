[gd_scene format=3 uid="uid://leaderboard"]

[ext_resource type="Script" path="res://Scenes/UIScenes/leaderboard.gd" id="1"]
[ext_resource type="AudioStreamMP3" uid="uid://csxv5iem6rdp1" path="res://Assets/Audio/Music/MainMenu-TitleScreenMusic.mp3" id="2_menu_music"]
[ext_resource type="CompressedTexture2D" uid="uid://tj71abmlww2w" path="res://Assets/UI/Art/rm218-bb-07.jpg" id="3_bg_image"]

[node name="LeaderboardMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("3_bg_image")
expand_mode = 2
stretch_mode = 6
metadata/_edit_use_anchors_ = true

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -400.0
offset_top = -350.0
offset_right = 400.0
offset_bottom = 350.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
text = "Global Leaderboard"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Play more to climb the ranks! The more waves you survive across all your games, the higher you place. \"Best Run\" is your highest wave count in a single game, and \"Wins\" means you cleared all waves."
horizontal_alignment = 1
autowrap_mode = 3

[node name="PlayerRankLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Your Rank: Loading..."
horizontal_alignment = 1

[node name="RefreshButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
text = "Refresh Leaderboard"

[node name="ScrollContainer" type="ScrollContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="LeaderboardList" type="VBoxContainer" parent="VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 5

[node name="BackButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
text = "Back"

[node name="MenuMusic" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_menu_music")
volume_db = -6.0
autoplay = false

[connection signal="pressed" from="VBoxContainer/RefreshButton" to="." method="_on_refresh"]
[connection signal="pressed" from="VBoxContainer/BackButton" to="." method="_on_back"]
